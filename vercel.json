{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm ci",
  "functions": {
    "app/api/analysis/route.ts": {
      "maxDuration": 60
    },
    "app/api/cron/train/route.ts": {
      "maxDuration": 300
    },
    "app/api/cron/news/route.ts": {
      "maxDuration": 60
    },
    "app/api/feed/route.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/train",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/news",
      "schedule": "0 2 * * *"
    }
  ]
}